// 测试文件不进产物：它们 import vitest（devDependency），随 dist 发出去只会在运行时炸。
{
  "extends": "../../tsconfig.pkg.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./node_modules/.tmp/tsc-decl",
    "rootDir": "./src",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
