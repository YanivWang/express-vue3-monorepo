# 使用国内镜像源(本机读， docker容器也读)
registry=https://registry.npmmirror.com/

# 私有 scope：@yanivjs/* 只发布在自建 Verdaccio 上，公共镜像源没有。
# 这里只写「去哪找」，凭据不进仓库——各上下文按需注入：
#   镜像构建 → BuildKit secret（见 docker/Dockerfile.pc-portal、Dockerfile.dev）
#   dev 容器运行期 → compose 只读挂载宿主 ~/.npmrc
# ⚠️ 该地址当前解析到宿主 127.0.0.1（容器内经 compose 的 extra_hosts 走 host-gateway）；
#    私仓迁到公网可达地址后，改这一行即可，并可删掉各处的 extra_hosts 与凭据注入。
@yanivjs:registry=http://verdaccio.wxbjq.net.cn/
