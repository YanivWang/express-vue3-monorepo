APP_ENV=development
NODE_ENV=development

# 首个后台 super_admin：须在本文件配置非空的 ADMIN_BOOTSTRAP_USERNAME / ADMIN_BOOTSTRAP_PASSWORD；API bootstrap、scripts/ensure-super-admin.ts、synthetic-it 均只读此二键（无代码兜底）。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin_dev_change_me

JWT_SECRET=replace_with_random_string_at_least_32_characters_long

PORT=3000
APP_HOST_PORT=3000

LOG_LEVEL=info
# 日志默认只走 stdout（12-Factor；容器内写文件 docker logs 看不到、重建即丢）。
# 需要本地留存文件时打开：
# LOG_TO_FILE=1

# --- 认证令牌 ---
# 访问令牌短时效、只存在于前端内存；刷新令牌走 HttpOnly + SameSite=Strict Cookie，服务端可撤销。
# 默认：访问令牌 15 分钟，刷新令牌 7 天。
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# 轮换后的并发宽限（秒）：多标签页/门户与管理端同时刷新时共用同一枚 Cookie，
# 窗口内的重复提交按幂等重放处理：原样返回当初那一枚继任令牌，既不判重放也不补发新的
# （补发会让一枚已用令牌重放 N 次就铸出 N 条独立令牌链）；0 = 严格模式（任何重复提交都撤销令牌家族）。
# REFRESH_ROTATION_GRACE_SECONDS=30
# 绝对会话寿命（秒），0 关闭，默认 30 天。刷新令牌每轮换一次就重置一次有效期，是纯滑动过期：
# 只要保持每周至少刷新一次，同一次登录派生的会话就能无限期活下去——包括拿着被盗令牌的那个人。
# 这条硬线让每次登录到点必须重新做一次真正的身份认证。
# REFRESH_SESSION_ABSOLUTE_TTL_SECONDS=2592000
# 刷新令牌 Cookie 是否要求 HTTPS：1/true 恒开，0/false 恒关，auto 按本次请求是否 HTTPS 判定。
# 生产默认开启；本地 http://localhost 调试时浏览器不会保存 Secure Cookie，故非生产默认关闭。
# ⚠️ 生产若只在网关暴露明文 HTTP（本仓 Compose 默认如此，且前面没有再套 TLS），
#    恒开会让浏览器静默丢弃刷新 Cookie —— 表现为「能登录、刷新页面即掉登录态」。
#    此时要么在网关终止 TLS（并设 TRUST_PROXY），要么设 auto。
# AUTH_COOKIE_SECURE=1

# --- API 文档 ---
# /api-docs 与 /openapi.yaml：1/true 开，0/false 关；未设置时生产默认关闭、其余环境默认开启。
# openapi.yaml 是这套服务最完整的一份攻击面清单（每个路由、每个参数、每条权限码，
# 连「哪些接口不需要 Bearer」都写着），对开发是资产，对外网是地图。
# 确需在生产查文档就显式打开，并让它只经内网或鉴权之后的入口可达。
# API_DOCS_ENABLED=1

# --- 限流（阈值由环境变量控制，不再硬编码；默认值面向生产）---
# 计数存于 Redis（key 前缀 rl:），多副本共用同一个桶；Redis 异常时放行并记 error 日志。
# 全局：15 分钟 / 1000 次
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000
# RATE_LIMIT_GLOBAL_MAX=1000
# 认证接口（注册 / 登录）：1 分钟 / 10 次
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10
# 刷新接口单列一档，只统计「携带了刷新 Cookie」的失败请求（刷新是每个登录会话的自动行为，
# 与登录共用一个桶会在 NAT 出口把正常用户挡在门外；而没带凭证的尝试并未在猜凭证，
# 若也计数，匿名访客的首屏就会把桶吃满、反过来把同一 IP 上真正登录的用户挡在门外）：1 分钟 / 30 次
# RATE_LIMIT_REFRESH_WINDOW_MS=60000
# RATE_LIMIT_REFRESH_MAX=30

# --- 优雅退出 ---
# 收到 SIGTERM 后等待在途请求收尾的最长时间（毫秒），须小于编排层的宽限期
# （docker stop 默认 10s、K8s terminationGracePeriodSeconds 默认 30s）。
# SHUTDOWN_TIMEOUT_MS=8000
# 摘流量等待（毫秒），默认 0。收到 SIGTERM 后 /ready 会立刻翻成 503，但探针是轮询的：
# 翻完就立即关监听的话，编排层来不及探到、也就来不及把本实例从后端列表里摘掉，
# 滚动更新期间因此出现零星 502。这段等待就是留给它「看见并摘掉」的时间，
# 取值略大于一个就绪探针周期即可。单机 Compose 无滚动更新，故默认不等待；
# 上 K8s / 多副本时应显式配置（或改用 K8s 的 preStop sleep，两者择一）。
# SHUTDOWN_DRAIN_MS=5000

# --- 数据库迁移 ---
# 表结构由 src/migrations/* 版本化管理，启动时自动执行（多副本由 MySQL 命名锁串行化）。
# 若发布流程更倾向把迁移作为独立步骤（init container / 发布前 job），设为 0 并在流水线里跑 pnpm db:migrate。
# DB_AUTO_MIGRATE=0

# --- CORS（浏览器跨域）---
# development 下可不写 CORS_ORIGINS：等价允许任意 Origin，便于本地多端调试。
# 需要白名单时：英文逗号分隔「完整 Origin」（协议 + 主机 + 端口），不要夹杂空格。
# 常见前端本地示例（Vite 默认 5173；按你实际端口改）：
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 多个环境：
# CORS_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173

# --- 反向代理（Express trust proxy）---
# 应用前面有 Nginx / Ingress / 负载均衡时，为使 req.ip、req.protocol 等贴近真实客户端，可启用。
# 直连本机调试可不写；写了则按 src/app.ts：1 或 true = 信任 1 层代理；纯数字 = 信任的 hop 数。
# 典型：前面只有一层 Nginx
# TRUST_PROXY=1
# 或等价：
# TRUST_PROXY=true
# 前面经过两层代理（例如 CDN + 网关）时可尝试：
# TRUST_PROXY=2

# --- Redis ---
# Docker 内 rest-api：`docker-compose.base.yaml` 会注入 REDIS_URL（redis 服务名 + 密码），覆盖本项。
REDIS_PASSWORD=dev_redis_password_change_me
# 宿主跑后端（pnpm rest-api:dev）且 Redis 映射在 6379 时用（密码须与上行的 REDIS_PASSWORD 一致）：
REDIS_URL=redis://:dev_redis_password_change_me@127.0.0.1:6379

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=express-vue3-monorepo
DB_USER=app_user
DB_PWD=app_password_123456

# 注意：本文件随仓库提交，口令公开可见，必须是占位值。
# 若你曾在此填过真实口令，改这里并不能把它从 git 历史里抹掉——请直接轮换该口令。
# 本地私有覆盖写 .env.development.local（已被 .gitignore 忽略）。
MYSQL_ROOT_PASSWORD=dev_root_password_change_me
