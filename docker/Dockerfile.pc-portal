# pc-portal：构建静态资源后由内置 Nginx 仅托管 SPA（无反代）；HTTP 入口由 docker/nginx/gateway*.docker.conf 统一分流。
# 构建上下文为仓库根目录：
#   docker build -f docker/Dockerfile.pc-portal .

FROM node:22-bookworm-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

ARG PNPM_VERSION=10.17.0
# 镜像源可覆盖：默认走 npmmirror（国内构建快得多），但海外 / 公司内网 CI 需要能改，
# 否则构建会被强行导流到一个它根本连不通的地址。
#   docker build --build-arg NPM_REGISTRY=https://registry.npmjs.org ...
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm config set registry ${NPM_REGISTRY} \
  && npm install -g pnpm@${PNPM_VERSION}

WORKDIR /app

ENV HUSKY=0

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
# tsconfig.pkg.json 必须一起进来：packages/shared 的 tsconfig.json `extends` 它，
# 而 Vite 构建时 esbuild 会为 packages/shared/src 下的每个 .ts 读取最近的 tsconfig；
# 解析不到 extends 会直接让 `vite build` 失败（后端镜像一直是两份一起拷的，这里漏了）。
COPY tsconfig.base.json tsconfig.pkg.json ./
COPY .npmrc ./
# 根 package.json 的 prepare 钩子实现（生产安装缺 husky 时安静跳过）
COPY scripts/prepare-husky.mjs scripts/prepare-husky.mjs

# 与 Dockerfile.dev 对齐：满足 lockfile 与工作区解析；实际构建仅依赖 pc-portal 子图
COPY apps/backend/rest-api/package.json apps/backend/rest-api/
COPY apps/frontend/pc-portal/package.json apps/frontend/pc-portal/
COPY apps/frontend/pc-admin/package.json apps/frontend/pc-admin/
COPY packages/request-core/package.json packages/request-core/
COPY packages/shared/package.json packages/shared/

# `@yanivjs/*` 是私有 scope，只存在于自建 Verdaccio 上，公网 registry 没有。
# 仓库的 .npmrc 只配了公共镜像源，因此这一步需要额外的 scope 映射与凭据，
# 两者都在开发者的用户级 `~/.npmrc` 里——那份文件**不该**进仓库（含 authToken）。
#
# 所以经 BuildKit secret 挂进来：secret 只在这条 RUN 的生命周期内可见，
# 不会写进任何镜像层，`docker history` 也翻不到。
# 挂到 /root/.npmrc 是因为构建阶段以 root 运行，pnpm 正是从那里读用户级配置。
#
# secret 缺失时 pnpm 会退回仓库 .npmrc，私有包随即 404——这是有意的：
# 与其静默装出一个缺包的镜像，不如当场失败。
#
# ⚠️ 这一步在 GitHub Actions 上必然失败：私仓当前绑在 127.0.0.1，runner 路由不到。
# 待私仓迁到公网可达地址后，把 scope 映射写进仓库 .npmrc、凭据走 CI secret，
# 即可删掉这里的 secret 挂载与 compose 里配套的 extra_hosts。
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    pnpm install --frozen-lockfile --filter "@express-vue3-monorepo/pc-portal..."

COPY apps/frontend/pc-portal apps/frontend/pc-portal
COPY packages/request-core packages/request-core
COPY packages/shared packages/shared

# 与同域反代一致：留空则浏览器请求相对路径 /api …
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN pnpm --filter @express-vue3-monorepo/pc-portal run build

FROM nginx:1.31-alpine

COPY --from=builder /app/apps/frontend/pc-portal/dist /usr/share/nginx/html
# SPA 仅用静态路由；反向代理统一到顶层 gateway*.docker.conf
COPY docker/nginx/pc-portal-static.conf /etc/nginx/nginx.conf
# nginx.conf 里的每个 add_header 块都 include 它（add_header 不继承，见该文件顶部说明）
COPY docker/nginx/spa-security-headers.conf /etc/nginx/spa-security-headers.conf
