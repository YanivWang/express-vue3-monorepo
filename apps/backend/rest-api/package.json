{
  "name": "@express-vue3-monorepo/rest-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec tsx src/server.ts",
    "dev:debug": "cross-env NODE_ENV=development nodemon --inspect=0.0.0.0:9229 --exec tsx src/server.ts",
    "test": "pnpm run test:unit && pnpm run test:env",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:env": "tsx scripts/test-env.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:migrate:undo": "tsx scripts/migrate.ts down",
    "db:dedupe-indexes": "tsx scripts/dedupe-mysql-redundant-indexes.ts",
    "db:drop-create": "tsx scripts/reset-db.ts",
    "db:seed-categories": "tsx scripts/it-seed-categories.ts",
    "db:seed-post": "tsx scripts/synthetic-it-clear-posts.ts && tsx scripts/synthetic-it-run.ts"
  },
  "dependencies": {
    "@express-vue3-monorepo/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "mysql2": "^3.24.3",
    "rate-limit-redis": "^6.0.1",
    "redis": "^5.12.1",
    "sanitize-html": "^2.17.7",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "catalog:",
    "@types/compression": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/multer": "catalog:",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.1",
    "@types/swagger-ui-express": "catalog:",
    "nodemon": "^3.1.14",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.19.5",
    "pnpm": ">=10.17.0"
  }
}
